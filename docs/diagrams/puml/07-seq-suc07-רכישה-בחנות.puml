@startuml
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequence {
ArrowColor black
ArrowFontColor black
ActorBorderColor black
ActorBackgroundColor #66CCFF
LifeLineBorderColor black
LifeLineBackgroundColor #99DDFF
ParticipantBorderColor black
ParticipantBackgroundColor #66CCFF
ParticipantFontColor black
ParticipantFontSize 13
GroupBorderColor black
GroupBackgroundColor white
GroupHeaderFontColor black
}

actor "לקוח" as C
participant "ניהול החנות" as SM
participant "מסד נתוני החנות" as DB
participant "שירות הסליקה" as PAY

activate C
C -> SM : 1.0 כניסה לחנות
activate SM
SM -> DB : 1.1 שליפת המוצרים
activate DB
DB --> SM : 1.2 החזרת רשימת המוצרים
deactivate DB
SM -> C : 1.3 הצגת כרטיסיות המוצרים
deactivate SM

C -> SM : 2.0 בחירת מוצר וכמות והוספה לסל
C -> SM : 2.1 כניסה לסל ולחיצה על "סיום ותשלום"
C -> SM : 2.2 בחירת איסוף עצמי או משלוח
C -> SM : 2.3 הזנת פרטי ההזמנה

group sd Loop
C -> SM : 3.0 הזנת פרטי האשראי
activate SM
SM -> PAY : 3.1 שליחת פרטי התשלום לסליקה
activate PAY
PAY --> SM : 3.2 החזרת אישור או דחייה
deactivate PAY
SM -> C : 3.3 הודעת שגיאה אם התשלום נכשל
deactivate SM
end

activate SM
SM -> DB : 4.0 שמירת ההזמנה
SM -> DB : 4.1 עדכון המלאי
activate DB
DB --> SM : 4.2 אישור השמירה
deactivate DB
SM -> C : 4.3 הודעת אישור עם מספר ההזמנה
deactivate SM
deactivate C
@enduml