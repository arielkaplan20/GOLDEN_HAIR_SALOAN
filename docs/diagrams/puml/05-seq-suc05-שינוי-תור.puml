@startuml
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequence {
ArrowColor black
ArrowFontColor black
ActorBorderColor black
ActorBackgroundColor #66CCFF
LifeLineBorderColor black
LifeLineBackgroundColor #99DDFF
ParticipantBorderColor black
ParticipantBackgroundColor #66CCFF
ParticipantFontColor black
ParticipantFontSize 13
GroupBorderColor black
GroupBackgroundColor white
GroupHeaderFontColor black
}

actor "לקוח" as C
participant "ניהול התורים" as AM
participant "מסד נתוני התורים" as DB

activate C
C -> AM : 1.0 כניסה לאזור "שינוי תור"
activate AM
AM -> DB : 1.1 שליפת התורים הקיימים
activate DB
DB --> AM : 1.2 החזרת רשימת התורים
deactivate DB
AM -> C : 1.3 הצגת התורים
deactivate AM

group sd Loop
C -> AM : 2.0 בחירת תור ותאריך חדש
activate AM
AM -> DB : 2.1 שליפת התורים התפוסים בתאריך החדש
activate DB
DB --> AM : 2.2 החזרת רשימת התורים
deactivate DB
AM -> AM : 2.3 חישוב השעות הפנויות
AM -> C : 2.4 הצגת השעות הפנויות
deactivate AM
end

C -> AM : 3.0 בחירת שעה ולחיצה על אישור
activate AM
AM -> DB : 3.1 שחרור המועד הישן
AM -> DB : 3.2 שמירת המועד החדש
activate DB
DB --> AM : 3.3 אישור העדכון
deactivate DB
AM -> C : 3.4 הודעת אישור שינוי התור
deactivate AM
deactivate C
@enduml