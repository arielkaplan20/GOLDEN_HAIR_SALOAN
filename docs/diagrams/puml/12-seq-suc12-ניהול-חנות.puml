@startuml
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequence {
ArrowColor black
ArrowFontColor black
ActorBorderColor black
ActorBackgroundColor #66CCFF
LifeLineBorderColor black
LifeLineBackgroundColor #99DDFF
ParticipantBorderColor black
ParticipantBackgroundColor #66CCFF
ParticipantFontColor black
ParticipantFontSize 13
GroupBorderColor black
GroupBackgroundColor white
GroupHeaderFontColor black
}

actor "מנהל ראשי" as A
participant "Shop and Orders Manager" as SM
participant "Shop and Orders DB" as DB

activate A
A -> SM : צעד 1 - המנהל הראשי לוחץ על אפשרות "ניהול חנות"
activate SM
SM -> DB : צעד 2.1 - המערכת פונה למסד הנתונים
activate DB
DB --> SM : צעד 2.2 - מסד הנתונים מחזיר את רשימת המוצרים
deactivate DB
SM -> A : צעד 2 - המערכת שולפת ומציגה את רשימת\nהמוצרים הקיימים ממסד הנתונים
deactivate SM

A -> SM : צעד 3 - המנהל הראשי בוחר את הפעולה הרצויה:\nהוספה, עדכון או מחיקה

group sd Loop
A -> SM : צעד 4 - המנהל הראשי מזין את פרטי המוצר
activate SM
SM -> SM : צעד 5 - המערכת מוודאת שהפרטים שהוזנו\nתקינים ומלאים
SM -> A : הסתעפות א.1 בצעד 5 - המערכת מציגה הודעת שגיאה ומציינת\nאת הפרטים שאינם תקינים או חסרים
SM -> A : הסתעפות א.2 בצעד 5 - חזרה לצעד 4
SM -> A : הסתעפות ב.1 בצעד 3 - המערכת מציגה חלון אישור מחיקה
deactivate SM
end

activate SM
SM -> DB : צעד 6 - המערכת מעדכנת את המוצר במסד הנתונים
activate DB
DB --> SM : צעד 6.1 - מסד הנתונים מאשר את העדכון
deactivate DB
SM -> A : צעד 7 - המערכת מציגה הודעת אישור\nעל ביצוע הפעולה
deactivate SM

A -> SM : צעד 8 - המנהל הראשי בוחר באפשרות "צפייה בהזמנות"
activate SM
SM -> DB : צעד 9.1 - המערכת פונה למסד הנתונים
activate DB
DB --> SM : צעד 9.2 - מסד הנתונים מחזיר את ההזמנות
deactivate DB

group sd Loop
SM -> A : צעד 9 - המערכת שולפת ומציגה את כל\nההזמנות הקיימות במערכת
SM -> A : הסתעפות ג.1 בצעד 9 - המערכת מציגה הודעה "אין הזמנות קיימות"
end
deactivate SM
deactivate A
@enduml