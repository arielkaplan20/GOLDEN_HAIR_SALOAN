@startuml
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequence {
ArrowColor black
ArrowFontColor black
ActorBorderColor black
ActorBackgroundColor #66CCFF
LifeLineBorderColor black
LifeLineBackgroundColor #99DDFF
ParticipantBorderColor black
ParticipantBackgroundColor #66CCFF
ParticipantFontColor black
ParticipantFontSize 13
GroupBorderColor black
GroupBackgroundColor white
GroupHeaderFontColor black
}

actor "משתמש" as U
participant "Users Manager" as UM
participant "Users DB" as DB

activate U
U -> UM : צעד 1 - המשתמש מזין את פרטיו האישיים
U -> UM : צעד 2 - המשתמש לוחץ על כפתור סיום הרשמה

group sd Loop
activate UM
UM -> UM : צעד 3 - המערכת מוודאת שהפרטים תקינים,\nמלאים ושהסיסמאות תואמות
UM -> U : הסתעפות א.1 בצעד 3 - המערכת מציגה התראה ברורה ומציינת\nאת הפרטים שאינם תקינים או חסרים
UM -> U : הסתעפות א.2 בצעד 3 - חזרה לצעד 1
deactivate UM
end

activate UM
UM -> UM : צעד 3.1 - המערכת מצפינה את הסיסמה
UM -> DB : צעד 3.2 - המערכת שומרת את המשתמש החדש
activate DB
DB --> UM : צעד 3.3 - מסד הנתונים מאשר את השמירה
deactivate DB
UM -> U : צעד 4 - המערכת מציגה חלון המודיע על כך שההרשמה\nעברה בהצלחה ומעבירה אותו לדף הכניסה
deactivate UM
deactivate U
@enduml