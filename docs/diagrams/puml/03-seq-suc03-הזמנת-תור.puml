@startuml
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequence {
ArrowColor black
ArrowFontColor black
ActorBorderColor black
ActorBackgroundColor #66CCFF
LifeLineBorderColor black
LifeLineBackgroundColor #99DDFF
ParticipantBorderColor black
ParticipantBackgroundColor #66CCFF
ParticipantFontColor black
ParticipantFontSize 13
GroupBorderColor black
GroupBackgroundColor white
GroupHeaderFontColor black
}

actor "לקוח" as C
participant "Appointments Manager" as AM
participant "Appointments DB" as ADB
participant "Service Providers DB" as SDB

activate C
C -> AM : צעד 1 - הלקוח בוחר את נותן השירות (הספר) המבוקש
C -> AM : צעד 2 - הלקוח בוחר תאריך מתוך לוח השנה

group sd Loop
activate AM
AM -> SDB : צעד 3.1 - המערכת שולפת את שעות העבודה של הספר
activate SDB
SDB --> AM : צעד 3.2 - מסד הנתונים מחזיר שעת פתיחה וסגירה
deactivate SDB
AM -> ADB : צעד 3.3 - המערכת שולפת את התורים התפוסים בתאריך
activate ADB
ADB --> AM : צעד 3.4 - מסד הנתונים מחזיר את רשימת התורים
deactivate ADB
AM -> C : צעד 3 - המערכת בודקת ומציגה שעות פנויות\nבלבד לתאריך שנבחר
AM -> C : הסתעפות א.1 בצעד 3 - המערכת מציגה הודעה כי אין\nשעות פנויות בתאריך זה
AM -> C : הסתעפות א.2 בצעד 3 - חזרה לצעד 2
deactivate AM
end

C -> AM : צעד 4 - הלקוח בוחר שעה פנויה ולוחץ על כפתור אישור
activate AM
AM -> ADB : צעד 5.1 - המערכת בודקת שוב שהשעה עדיין פנויה
activate ADB
ADB --> AM : צעד 5.2 - מסד הנתונים מאשר שהשעה פנויה
deactivate ADB
AM -> ADB : צעד 5.3 - המערכת שומרת את התור במסד הנתונים
AM -> C : צעד 5 - המערכת שומרת את התור ושולחת\nהודעת אישור ללקוח
deactivate AM
deactivate C
@enduml