@startuml
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequence {
ArrowColor black
ArrowFontColor black
ActorBorderColor black
ActorBackgroundColor #66CCFF
LifeLineBorderColor black
LifeLineBackgroundColor #99DDFF
ParticipantBorderColor black
ParticipantBackgroundColor #66CCFF
ParticipantFontColor black
ParticipantFontSize 13
GroupBorderColor black
GroupBackgroundColor white
GroupHeaderFontColor black
}

actor "מנהל ראשי" as A
participant "Appointments Manager" as AM
participant "Appointments DB" as DB

activate A
A -> AM : צעד 1 - המנהל הראשי מבצע לחיצה על\nאפשרות ניהול תורים
activate AM
AM -> DB : צעד 2 - המערכת מבצעת שליפת והצגת כלל\nהתורים ממסד הנתונים
activate DB
DB --> AM : צעד 2.1 - מסד הנתונים מחזיר את רשימת התורים
deactivate DB

group sd Loop
AM -> A : צעד 3 - המערכת מבצעת הצגת פירוט כלל התורים
AM -> A : הסתעפות א.2 בצעד 3 - המערכת מבצעת הצגת הודעה\n"אין תורים קיימים במערכת"
end
deactivate AM
deactivate A
@enduml