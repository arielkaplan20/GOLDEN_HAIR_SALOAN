@startuml
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequence {
ArrowColor black
ArrowFontColor black
ActorBorderColor black
ActorBackgroundColor #66CCFF
LifeLineBorderColor black
LifeLineBackgroundColor #99DDFF
ParticipantBorderColor black
ParticipantBackgroundColor #66CCFF
ParticipantFontColor black
ParticipantFontSize 13
GroupBorderColor black
GroupBackgroundColor white
GroupHeaderFontColor black
}

actor "מנהל ראשי" as A
participant "Users Manager" as UM
participant "Users DB" as DB

activate A
A -> UM : 1.0 כניסה לאזור "ניהול משתמשים"
activate UM
UM -> DB : 1.1 שליפת רשימת המשתמשים
activate DB
DB --> UM : 1.2 החזרת הרשימה
deactivate DB
UM -> A : 1.3 הצגת רשימת המשתמשים
deactivate UM

A -> UM : 2.0 בחירת משתמש ושינוי ההרשאה
activate UM
UM -> A : 2.1 הצגת חלון אישור השינוי
deactivate UM

group sd Loop
A -> UM : 3.0 אישור השינוי
activate UM
UM -> DB : 3.1 עדכון ההרשאה
activate DB
DB --> UM : 3.2 אישור העדכון
deactivate DB
UM -> A : 3.3 הודעת אישור על עדכון ההרשאה
UM -> A : 3.4 סיום ללא שינוי אם המנהל לא אישר
deactivate UM
end
deactivate A
@enduml