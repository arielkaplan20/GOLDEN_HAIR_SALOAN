@startuml
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequence {
ArrowColor black
ArrowFontColor black
ActorBorderColor black
ActorBackgroundColor #66CCFF
LifeLineBorderColor black
LifeLineBackgroundColor #99DDFF
ParticipantBorderColor black
ParticipantBackgroundColor #66CCFF
ParticipantFontColor black
ParticipantFontSize 13
GroupBorderColor black
GroupBackgroundColor white
GroupHeaderFontColor black
}

actor "נותן שירות" as B
participant "Schedule Manager" as SCM
participant "Appointments DB" as ADB
participant "Service Providers DB" as SDB

activate B
B -> SCM : 1.0 כניסה לאזור "יומן תורים"
activate SCM
SCM -> ADB : 1.1 שליפת התורים שנקבעו אליו בלבד
activate ADB
ADB --> SCM : 1.2 החזרת רשימת התורים
deactivate ADB
SCM -> B : 1.3 הצגת יומן התורים
deactivate SCM

B -> SCM : 2.0 כניסה לאזור "עריכת שעות עבודה"
activate SCM
SCM -> SDB : 2.1 שליפת שעות העבודה הנוכחיות
activate SDB
SDB --> SCM : 2.2 החזרת ימי ושעות העבודה
deactivate SDB
SCM -> B : 2.3 הצגת השעות לעריכה
deactivate SCM

group sd Loop
B -> SCM : 3.0 סימון הימים והזנת השעות
activate SCM
SCM -> SCM : 3.1 בדיקה ששעת הסגירה אחרי שעת הפתיחה
SCM -> B : 3.2 הצגת שגיאה אם השעות אינן תקינות
deactivate SCM
end

activate SCM
SCM -> SDB : 4.0 שמירת ימי ושעות העבודה
activate SDB
SDB --> SCM : 4.1 אישור השמירה
deactivate SDB
SCM -> B : 4.2 הודעת אישור העדכון
deactivate SCM
deactivate B
@enduml