@startuml
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequence {
ArrowColor black
ArrowFontColor black
ActorBorderColor black
ActorBackgroundColor #66CCFF
LifeLineBorderColor black
LifeLineBackgroundColor #99DDFF
ParticipantBorderColor black
ParticipantBackgroundColor #66CCFF
ParticipantFontColor black
ParticipantFontSize 13
GroupBorderColor black
GroupBackgroundColor white
GroupHeaderFontColor black
}

actor "User" as U
participant "Users Manager" as UM
participant "Users DB" as DB

activate U
U -> UM : 1.0 כניסה לאזור "הפרופיל שלי"
activate UM
UM -> DB : 1.1 שליפת הפרטים האישיים
activate DB
DB --> UM : 1.2 החזרת הפרטים
deactivate DB
UM -> U : 1.3 הצגת הפרטים הקיימים
deactivate UM

group sd Loop
U -> UM : 2.0 עדכון הפרטים ולחיצה על "שמירה"
activate UM
UM -> UM : 2.1 בדיקת תקינות ומלאות השדות
UM -> U : 2.2 הצגת שגיאה אם הפרטים אינם תקינים
deactivate UM
end

activate UM
UM -> DB : 3.0 עדכון הפרטים במסד הנתונים
activate DB
DB --> UM : 3.1 אישור העדכון
deactivate DB
UM -> U : 3.2 הודעת אישור על עדכון הפרטים
deactivate UM
deactivate U
@enduml