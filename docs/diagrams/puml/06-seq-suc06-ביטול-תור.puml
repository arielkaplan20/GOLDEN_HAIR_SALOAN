@startuml
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequence {
ArrowColor black
ArrowFontColor black
ActorBorderColor black
ActorBackgroundColor #66CCFF
LifeLineBorderColor black
LifeLineBackgroundColor #99DDFF
ParticipantBorderColor black
ParticipantBackgroundColor #66CCFF
ParticipantFontColor black
ParticipantFontSize 13
GroupBorderColor black
GroupBackgroundColor white
GroupHeaderFontColor black
}

actor "לקוח" as C
participant "Appointments Manager" as AM
participant "Appointments DB" as DB

activate C
C -> AM : צעד 1 - הלקוח נכנס לאזור "ביטול תור"
activate AM
AM -> DB : צעד 2.1 - המערכת שולפת את התורים הקיימים
activate DB
DB --> AM : צעד 2.2 - מסד הנתונים מחזיר את רשימת התורים
deactivate DB

group sd Loop
AM -> C : צעד 2 - המערכת בודקת ומציגה את התורים\nהקיימים של הלקוח
AM -> C : הסתעפות א.1 בצעד 2 - המערכת מציגה הודעה "אין תורים קיימים"
AM -> C : הסתעפות א.2 בצעד 2 - סיום התהליך
deactivate AM
end

C -> AM : צעד 3 - הלקוח לוחץ על כפתור "ביטול תור"\nליד התור הרלוונטי
activate AM
AM -> C : צעד 4 - המערכת מציגה חלון אישור ביטול
deactivate AM

group sd Loop
C -> AM : צעד 5 - הלקוח מאשר את ביטול התור בחלון האישור
activate AM
AM -> DB : צעד 6 - המערכת מוחקת את התור ממסד הנתונים\nומפנה את מועדו לכלל הלקוחות
activate DB
DB --> AM : צעד 6.1 - מסד הנתונים מאשר את המחיקה
deactivate DB
AM -> C : צעד 7 - המערכת מציגה הודעת אישור על ביטול התור
AM -> C : הסתעפות ב.1 בצעד 5 - התהליך מסתיים ללא ביצוע שינוי,\nוהתור נשאר במערכת
deactivate AM
end
deactivate C
@enduml