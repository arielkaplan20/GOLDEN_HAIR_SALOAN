@startuml
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequence {
ArrowColor black
ArrowFontColor black
ActorBorderColor black
ActorBackgroundColor #66CCFF
LifeLineBorderColor black
LifeLineBackgroundColor #99DDFF
ParticipantBorderColor black
ParticipantBackgroundColor #66CCFF
ParticipantFontColor black
ParticipantFontSize 13
GroupBorderColor black
GroupBackgroundColor white
GroupHeaderFontColor black
}

actor "נותן שירות" as B
participant "Schedule Manager" as SCM
participant "Appointments DB" as ADB
participant "Service Providers DB" as SDB

activate B
B -> SCM : צעד 1 - נותן השירות נכנס לאזור "יומן תורים"
activate SCM
SCM -> ADB : צעד 2 - המערכת שולפת ממסד הנתונים אך ורק\nאת התורים שנקבעו אליו
activate ADB
ADB --> SCM : צעד 2.1 - מסד הנתונים מחזיר את רשימת התורים
deactivate ADB

group sd Loop
SCM -> B : צעד 3 - המערכת בודקת ומציגה את פירוט\nהתורים הקיימים
SCM -> B : הסתעפות א.2 בצעד 3 - המערכת מציגה הודעה\n"לא נקבעו תורים עדיין"
deactivate SCM
end

B -> SCM : צעד 4 - נותן השירות בוחר באפשרות\n"עריכת שעות עבודה"
activate SCM
SCM -> SDB : צעד 5.1 - המערכת שולפת את שעות העבודה הנוכחיות
activate SDB
SDB --> SCM : צעד 5.2 - מסד הנתונים מחזיר את ימי ושעות העבודה
deactivate SDB
SCM -> B : צעד 5 - המערכת מציגה את ימי ושעות\nהעבודה הנוכחיים שלו
deactivate SCM

group sd Loop
B -> SCM : צעד 6 - נותן השירות מסמן את הימים שבהם הוא\nעובד ומזין שעת פתיחה וסגירה לכל יום
B -> SCM : צעד 7 - נותן השירות לוחץ על כפתור "שמירה"
activate SCM
SCM -> SCM : צעד 8 - המערכת מוודאת שהשעות תקינות ושעת\nהסגירה מאוחרת משעת הפתיחה
SCM -> B : הסתעפות ב.1 בצעד 8 - המערכת מציגה הודעת שגיאה מתאימה
deactivate SCM
end

activate SCM
SCM -> SDB : צעד 9.1 - המערכת שומרת את ימי ושעות העבודה
activate SDB
SDB --> SCM : צעד 9.2 - מסד הנתונים מאשר את השמירה
deactivate SDB
SCM -> B : צעד 9 - המערכת מעדכנת את ימי ושעות העבודה\nבמסד הנתונים ומציגה הודעת אישור
deactivate SCM
deactivate B
@enduml