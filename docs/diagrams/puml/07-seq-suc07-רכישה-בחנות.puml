@startuml
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequence {
ArrowColor black
ArrowFontColor black
ActorBorderColor black
ActorBackgroundColor #66CCFF
LifeLineBorderColor black
LifeLineBackgroundColor #99DDFF
ParticipantBorderColor black
ParticipantBackgroundColor #66CCFF
ParticipantFontColor black
ParticipantFontSize 13
GroupBorderColor black
GroupBackgroundColor white
GroupHeaderFontColor black
}

actor "לקוח" as C
participant "Shop and Orders Manager" as SM
participant "Shop and Orders DB" as DB
participant "Payment Service" as PAY

activate C
activate SM
SM -> DB : צעד 1.1 - המערכת שולפת את המוצרים
activate DB
DB --> SM : צעד 1.2 - מסד הנתונים מחזיר את רשימת המוצרים
deactivate DB
SM -> C : צעד 1.3 - המערכת מציגה את כרטיסיות המוצרים
deactivate SM
C -> SM : צעד 1 - הלקוח צופה במוצרים, בוחר מוצר וכמות,\nולוחץ "הוסף לסל"

group sd Loop
C -> SM : צעד 2 - הלקוח נכנס לאזור "הסל שלי"\nולוחץ על כפתור "סיום ותשלום"
activate SM
SM -> C : הסתעפות א.1 בצעד 3 - במידה והסל ריק, המערכת מציגה\nהודעה "הסל שלך ריק"
SM -> C : הסתעפות א.2 בצעד 3 - חזרה לצעד 1
deactivate SM
end

C -> SM : צעד 3 - הלקוח בוחר את אופן הקבלה:\n"איסוף עצמי" או "משלוח"
C -> SM : צעד 4 - הלקוח מזין את פרטי ההזמנה הנדרשים

group sd Loop
C -> SM : צעד 5 - הלקוח מועבר לדף תשלום ומזין\nאת פרטי האשראי
activate SM
SM -> PAY : צעד 5.1 - המערכת שולחת את פרטי התשלום לסליקה
activate PAY
PAY --> SM : צעד 5.2 - שירות הסליקה מחזיר אישור או דחייה
deactivate PAY
SM -> C : הסתעפות ב.2 בצעד 5 - המערכת מציגה הודעת שגיאה\n"תשלום נכשל, אנא נסה שנית"
SM -> C : הסתעפות ב.3 בצעד 5 - חזרה לצעד 5
deactivate SM
end

activate SM
SM -> DB : צעד 6.1 - המערכת שומרת את ההזמנה
SM -> DB : צעד 6.2 - המערכת מעדכנת את המלאי
activate DB
DB --> SM : צעד 6.3 - מסד הנתונים מאשר את השמירה
deactivate DB
SM -> C : צעד 6 - המערכת מציגה הודעת אישור\nכולל מספר הזמנה
deactivate SM
deactivate C
@enduml